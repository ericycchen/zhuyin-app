{
  "hosting": [
    {
      "target": "prod",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "test.js"
      ],
      "headers": [
        {
          "source": "/(sw\\.js|index\\.html|about\\.html|manifest\\.webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "dev",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "test.js"
      ],
      "headers": [
        {
          "source": "/(sw\\.js|index\\.html|about\\.html|manifest\\.webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}
